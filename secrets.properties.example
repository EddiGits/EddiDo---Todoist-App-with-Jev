# Copy to secrets.properties (git-ignored) and fill in.
# Keys are baked into the APK at build time.

# TypeSafe Jev: fast choices (project, labels, priority, alarm). https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# OpenRouter: used for dates in Tamil/Hindi when TypeSafe is set, for everything when it is not.
OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter model id. typesafe/jev-router is TypeSafe's Jev router.
OPENROUTER_MODEL=typesafe/jev-router

# Release signing (see README). Leave empty to build an unsigned release.
RELEASE_STORE_FILE=../keystore/eddido-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=eddido
RELEASE_KEY_PASSWORD=
